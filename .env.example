# ── Database (PostgreSQL) ────────────────────────────────────
# Local development: a plain Postgres URL is enough.
# Supabase / Vercel: Supabase → Connect → use the "Transaction pooler" URL (port 6543) here …
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/misbah?schema=public"
# … and the "Session pooler" or direct URL (port 5432) here — used only by `prisma migrate`.
# DIRECT_URL=""

# ── NextAuth (Auth.js v5) ────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the site (used for auth redirects). Must match the address users visit.
# On Vercel leave this UNSET: the host is detected per request, so preview deployments work too.
AUTH_URL="http://localhost:3000"

# ── Initial admin account (used by `npm run db:seed`) ────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# ── Object storage for e-Slips & activity images ─────────────
# Supabase Storage (default). Use a PRIVATE bucket for slips.
SUPABASE_URL="https://rlzuzjcjktagozdwfnof.supabase.co"
# Server-only secret (Supabase → Project Settings → API Keys → service_role / secret key).
# NEVER prefix with NEXT_PUBLIC_ and never commit it. Leave empty in local dev to store slips on disk.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SLIP_BUCKET="slips"
SUPABASE_MEDIA_BUCKET="media"

# Optional: store slips on this server's disk instead of Supabase (single-server deploys only)
# SLIP_STORAGE="local"
